<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        LaunchTheme is rendered by the Android window manager while the
        Flutter engine warms up. The full-bleed obsidian drawable prevents
        the white icon-flash described in pitfalls §16.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!--
        NormalTheme takes over as soon as Flutter draws its first frame.
        `windowLayoutInDisplayCutoutMode = shortEdges` reports the
        display-cutout inset in BOTH orientations so the WebView can keep
        a safe zone around the camera notch on the long edge in landscape
        (pitfalls §14).
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
