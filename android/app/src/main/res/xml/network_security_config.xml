<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext HTTP is permitted only for partner redirect fronts that
        the manager confirms cannot be issued as HTTPS. Blanket-allowing
        cleartext would be an audit risk (pitfalls §17) — narrow this to
        per-domain overrides as needed.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
