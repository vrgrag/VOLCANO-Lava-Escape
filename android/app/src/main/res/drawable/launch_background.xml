<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-bleed obsidian splash. Kills the white window-background flash
    that Android draws while Flutter initialises (pitfalls §16). We do
    NOT layer the launcher icon on top — that pattern shows a rectangular
    frame around the icon on cold start.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background"/>
</layer-list>
